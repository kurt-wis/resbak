# Godot 4+ specific ignores
.godot/
/android/

# Agent / tool state
.opencode/
.claude/settings.local.json

# Python / Blender scratch
__pycache__/
*.pyc
*.blend1

# Meshy downloads: raw, re-downloadable payloads. The folder stays (it is where the
# batch scripts drop new GLBs) but only its .gdignore is tracked, so Godot stops
# importing 30-40 MB of uncooked meshes.
meshy_output/*
!meshy_output/.gdignore

# Gate output scratch and stray git-hook folder
gate_*.txt
/dev/

