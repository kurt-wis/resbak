[sub_resource type="Shader" id="Shader_n8dts"]
code = "shader_type spatial;
render_mode cull_disabled;
varying vec3 world;
void vertex(){ VERTEX.y += sin(VERTEX.x*0.8+TIME*0.55)*0.018+cos(VERTEX.z*1.2+TIME*0.4)*0.012; world=(MODEL_MATRIX*vec4(VERTEX,1.)).xyz; }
void fragment(){ vec2 p=world.xz; float n=sin(p.x*2.4+sin(p.y*3.1))*sin(p.y*2.8+p.x*0.4); ALBEDO=mix(vec3(0.07,0.26,0.32),vec3(0.10,0.32,0.38),n*0.5+0.5); ROUGHNESS=0.52; SPECULAR=0.22; }"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_f2yno"]
