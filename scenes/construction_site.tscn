[sub_resource type="Shader" id="Shader_gvydg"]
code = "shader_type spatial;
varying vec3 world;
void vertex(){ world=(MODEL_MATRIX*vec4(VERTEX,1.)).xyz; }
void fragment(){ vec2 p=world.xz; float n=sin(p.x*1.7)*cos(p.y*2.1)*0.5+sin(p.x*8.1+p.y*5.6)*0.14; ALBEDO=mix(vec3(0.65,0.43,0.21),vec3(0.81,0.60,0.33),clamp(0.65+n*0.22,0.,1.)); ROUGHNESS=1.; }"

